// Static site served by Cloudflare Workers static assets.
// Headers live in public/_headers.
{
  "name": "osvauld-landing",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Branch builds run `wrangler preview`, which needs this block; previews
  // use only the top-level settings above.
  "previews": {}
}
