---
import type { TranslationKeys } from "../../i18n/ui";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<section
  class="w-screen flex flex-col justify-start items-center mx-auto px-auto bg-dark1 px-4 pt-0 sm:pt-12 text-white"
>
  <div class="w-full mx-auto max-w-[1400px]">
    <h2
      class="max-w-[1400px] mx-auto text-sthalamPrimary font-JetBrainsMono text-left text-2xl md:text-4xl font-normal mt-28 mb-10"
    >
      {translations.sthalamPhilosophy.title}
    </h2>
    <p
      class="max-w-[1400px] mx-auto text-left text-base md:text-lg font-JetBrainsMono text-[#F1F7FE] opacity-70 leading-relaxed"
      set:html={translations.sthalamPhilosophy.description}
    >
    </p>
  </div>
</section>
