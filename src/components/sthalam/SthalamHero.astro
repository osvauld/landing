---
import type { TranslationKeys } from "../../i18n/utils";

export interface Props {
  translations: TranslationKeys;
}

import { GithubIcon } from "../../assets/icons/GithubIcon";

const { translations } = Astro.props;
---

<section
  class="pt-10 lg:pt-16 px-2 pr-1 flex flex-col justify-start items-center bg-dark1 overflow-x-hidden"
  id="home"
>
  <div
    class="max-w-[1440px] w-full overflow-x-hidden overflow-y-hidden pt-24 xll:px-12"
  >
    <div class="text-sthalamPrimary text-xs sm:text-sm font-bold flex justify-start text-left px-4">
      <a
        class="flex justify-center items-center font-normal text-sm xl:text-base rounded-md border border-sthalamPrimary h-full px-4 py-2 cursor-pointer"
        href="https://github.com/osvauld/osvauld"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="whitespace-nowrap">{translations.sthalamHero.openSource}</span>
        <span class="h-5 w-px bg-sthalamPrimary mx-2"></span>
        <span class="flex text-white4 justify-center items-center whitespace-nowrap">
          <span class="mr-2 flex justify-center items-center">
            <GithubIcon color={"#cba6f7"} size={18} />
          </span>
        </span>
      </a>
    </div>

    <div class="flex flex-col px-4 py-10">
      <div class="flex-1">
        <h1 class="text-white1 font-medium font-Jakartha text-left text-5xl md:text-6xl lg:text-7xl xl:text-8xl">
          <span class="whitespace-normal lg:whitespace-nowrap text-sthalamPrimary font-JetBrainsMono tracking-tighter" set:html={translations.sthalamHero.title}>
          </span>
        </h1>
        <div class="text-faqAnswer font-light text-base md:text-lg xl:text-xl pt-2 md:pt-12 tracking-wide max-w-[99vw] text-left font-JetBrainsMono" set:html={translations.sthalamHero.description}>
        </div>
      </div>
    </div>
  </div>

</section>
