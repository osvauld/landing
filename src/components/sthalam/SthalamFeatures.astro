---
import type { TranslationKeys } from "../../i18n/utils";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<div class="w-full flex flex-col items-center mx-auto bg-dark1 px-4 pt-0 sm:pt-12 text-white">
  <section class="py-20 lg:px-5 max-w-6xl mx-auto">
    <div class="text-center mb-15">
      <h2 class="text-4xl md:text-6xl text-left mb-4 text-sthalamPrimary font-JetBrainsMono">{translations.sthalamFeatures.title}</h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-1 md:gap-6 mt-10 bg-dark1">
      <!-- Sovereign Publishing -->
      <div class="border border-white/10 rounded-2xl p-4 sm:p-8 hover:border-white/20 relative overflow-hidden transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#cba6f7]">
        <svg class="w-8 h-8 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="#cba6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 17L12 22L22 17" stroke="#cba6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 12L12 17L22 12" stroke="#cba6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <h3 class="text-sm md:text-xl font-normal my-4 text-white relative z-10 font-JetBrainsMono">{translations.sthalamFeatures.sovereignPublishing.title}</h3>
        <p class="text-customGray text-xs md:text-base font-JetBrainsMono leading-relaxed relative z-10" set:html={translations.sthalamFeatures.sovereignPublishing.description}>
        </p>
      </div>

      <!-- Interactive Websites -->
      <div class="border border-white/10 rounded-2xl p-4 sm:p-8 hover:border-white/20 relative overflow-hidden transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#cba6f7]">
        <svg class="w-8 h-8 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M3 3H21C21.55 3 22 3.45 22 4V20C22 20.55 21.55 21 21 21H3C2.45 21 2 20.55 2 20V4C2 3.45 2.45 3 3 3ZM3.5 4.5V8H20.5V4.5H3.5ZM3.5 19.5H20.5V9.5H3.5V19.5Z" fill="#cba6f7"></path>
        </svg>
        <h3 class="text-sm md:text-xl font-normal my-4 text-white relative z-10 font-JetBrainsMono">{translations.sthalamFeatures.websites.title}</h3>
        <p class="text-customGray text-xs md:text-base font-JetBrainsMono leading-relaxed relative z-10" set:html={translations.sthalamFeatures.websites.description}>
        </p>
      </div>

      <!-- Blogs & Newsletters -->
      <div class="border border-white/10 rounded-2xl p-4 sm:p-8 hover:border-white/20 relative overflow-hidden transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#cba6f7]">
        <svg class="w-8 h-8 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M13.56 2H4V22H20V8.44L13.56 2ZM14 4.56L17.44 8H14V4.56ZM5.5 20.5V3.5H12.5V8.25C12.5 8.94 13.06 9.5 13.75 9.5H18.5V20.5H5.5ZM13 16H7.5V17.5H13V16ZM7.5 12.5H16.5V14H7.5V12.5Z" fill="#cba6f7"></path>
        </svg>
        <h3 class="text-sm md:text-xl font-normal my-4 text-white relative z-10 font-JetBrainsMono">{translations.sthalamFeatures.blogsNewsletters.title}</h3>
        <p class="text-customGray text-xs md:text-base font-JetBrainsMono leading-relaxed relative z-10" set:html={translations.sthalamFeatures.blogsNewsletters.description}>
        </p>
      </div>

      <!-- Forms & Surveys -->
      <div class="border border-white/10 rounded-2xl p-4 sm:p-8 hover:border-white/20 relative overflow-hidden transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#cba6f7]">
        <svg class="w-8 h-8 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M19 3H5C3.89 3 3 3.9 3 5V19C3 20.1 3.89 21 5 21H19C20.11 21 21 20.1 21 19V5C21 3.9 20.11 3 19 3ZM19 19H5V5H19V19ZM17 12H7V14H17V12ZM17 8H7V10H17V8ZM17 16H7V18H17V16Z" fill="#cba6f7"/>
        </svg>
        <h3 class="text-sm md:text-xl font-normal my-4 text-white relative z-10 font-JetBrainsMono">{translations.sthalamFeatures.formsSubmissions.title}</h3>
        <p class="text-customGray text-xs md:text-base font-JetBrainsMono leading-relaxed relative z-10" set:html={translations.sthalamFeatures.formsSubmissions.description}>
        </p>
      </div>

      <!-- Comment Threads -->
      <div class="border border-white/10 rounded-2xl p-4 sm:p-8 hover:border-white/20 relative overflow-hidden transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#cba6f7]">
        <svg class="w-8 h-8 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7 9C5.07 9 3.5 7.43 3.5 5.5C3.5 3.57 5.07 2 7 2C8.93 2 10.5 3.57 10.5 5.5C10.5 7.43 8.93 9 7 9ZM7 3.5C5.895 3.5 5 4.395 5 5.5C5 6.605 5.895 7.5 7 7.5C8.105 7.5 9 6.605 9 5.5C9 4.395 8.105 3.5 7 3.5ZM13.5 5.5C13.5 7.43 15.07 9 17 9C18.93 9 20.5 7.43 20.5 5.5C20.5 3.57 18.93 2 17 2C15.07 2 13.5 3.57 13.5 5.5ZM15 5.5C15 4.395 15.895 3.5 17 3.5C18.105 3.5 19 4.395 19 5.5C19 6.605 18.105 7.5 17 7.5C15.895 7.5 15 6.605 15 5.5ZM8.5 12.5C8.5 14.43 10.07 16 12 16C13.93 16 15.5 14.43 15.5 12.5C15.5 10.57 13.93 9 12 9C10.07 9 8.5 10.57 8.5 12.5ZM10 12.5C10 11.395 10.895 10.5 12 10.5C13.105 10.5 14 11.395 14 12.5C14 13.605 13.105 14.5 12 14.5C10.895 14.5 10 13.605 10 12.5ZM15.92 19.925L16.53 22.195V22.19L17.98 21.8L17.37 19.535C17.05 18.335 15.96 17.495 14.715 17.495H9.28502C8.04502 17.495 6.95002 18.335 6.63002 19.535L6.02002 21.805L7.47002 22.195L8.08002 19.925C8.22502 19.38 8.72002 19 9.28502 19H14.715C15.28 19 15.775 19.38 15.92 19.925Z" fill="#cba6f7"></path>
        </svg>
        <h3 class="text-sm md:text-xl font-normal my-4 text-white relative z-10 font-JetBrainsMono">{translations.sthalamFeatures.comments.title}</h3>
        <p class="text-customGray text-xs md:text-base font-JetBrainsMono leading-relaxed relative z-10" set:html={translations.sthalamFeatures.comments.description}>
        </p>
      </div>

      <!-- UCAN Authorization -->
      <div class="border border-white/10 rounded-2xl p-4 sm:p-8 hover:border-white/20 relative overflow-hidden transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#cba6f7]">
        <svg class="w-8 h-8 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M6.25481 20.805L7.7448 22.305L11.3048 18.745L9.8048 17.245L12.2598 14.79C13.1848 15.255 14.2098 15.495 15.2448 15.495C18.9648 15.495 21.9948 12.465 21.9948 8.745C21.9948 5.025 18.9648 1.995 15.2448 1.995C11.5248 1.995 8.4948 5.025 8.4948 8.745C8.4948 9.77999 8.7398 10.8 9.1998 11.73L2.0698 18.86C1.5848 19.35 1.5848 20.145 2.0698 20.63L3.3648 21.925C3.8548 22.41 4.64981 22.41 5.1348 21.925L6.25481 20.805ZM4.2498 20.69L3.3148 19.755L11.0848 11.985L10.7748 11.48C10.2698 10.65 10.0048 9.71 10.0048 8.75C10.0048 5.855 12.3598 3.5 15.2548 3.5C18.1498 3.5 20.5048 5.855 20.5048 8.75C20.5048 11.645 18.1498 14 15.2548 14C14.2948 14 13.3498 13.735 12.5248 13.23L12.0198 12.92L7.68981 17.25L9.1898 18.75L7.7498 20.19L6.25481 18.685L4.2498 20.69ZM11.5 8.75C11.5 10.82 13.18 12.5 15.25 12.5C17.32 12.5 19 10.82 19 8.75C19 6.68 17.32 5 15.25 5C13.18 5 11.5 6.68 11.5 8.75ZM13 8.75C13 7.51 14.01 6.5 15.25 6.5C16.49 6.5 17.5 7.51 17.5 8.75C17.5 9.99 16.49 11 15.25 11C14.01 11 13 9.99 13 8.75Z" fill="#cba6f7"></path>
        </svg>
        <h3 class="text-sm md:text-xl font-normal my-4 text-white relative z-10 font-JetBrainsMono">{translations.sthalamFeatures.ucanAuth.title}</h3>
        <p class="text-customGray text-xs md:text-base font-JetBrainsMono leading-relaxed relative z-10" set:html={translations.sthalamFeatures.ucanAuth.description}>
        </p>
      </div>

      <!-- Direct Distribution -->
      <div class="border border-white/10 rounded-2xl p-4 sm:p-8 hover:border-white/20 relative overflow-hidden transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#cba6f7]">
        <svg class="w-8 h-8 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M21.04 2.96C20.69 2.61 20.185 2.5 19.725 2.67L2.82504 8.895C2.35504 9.065 2.03504 9.5 2.01004 10C1.98004 10.5 2.25504 10.965 2.70004 11.185L9.44504 14.555L12.815 21.3C13.03 21.725 13.46 21.99 13.935 21.99C13.96 21.99 13.98 21.99 14.005 21.99C14.505 21.965 14.935 21.64 15.11 21.175L21.33 4.275C21.5 3.81 21.39 3.31 21.04 2.96ZM3.88504 10.105L18.055 4.885L9.85004 13.085L3.88504 10.1V10.105ZM13.895 20.115L10.91 14.15L19.115 5.945L13.895 20.115Z" fill="#cba6f7"></path>
        </svg>
        <h3 class="text-sm md:text-xl font-normal my-4 text-white relative z-10 font-JetBrainsMono">{translations.sthalamFeatures.noIntermediaries.title}</h3>
        <p class="text-customGray text-xs md:text-base font-JetBrainsMono leading-relaxed relative z-10" set:html={translations.sthalamFeatures.noIntermediaries.description}>
        </p>
      </div>

      <!-- Your Data, Your Control -->
      <div class="border border-white/10 rounded-2xl p-4 sm:p-8 hover:border-white/20 relative overflow-hidden transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#cba6f7]">
        <svg class="w-8 h-8 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 11.99H19C18.47 16.11 15.72 19.78 12 20.93V12H5V6.3L12 3.19V11.99Z" fill="#cba6f7"/>
        </svg>
        <h3 class="text-sm md:text-xl font-normal my-4 text-white relative z-10 font-JetBrainsMono">{translations.sthalamFeatures.dataPrivacy.title}</h3>
        <p class="text-customGray text-xs md:text-base font-JetBrainsMono leading-relaxed relative z-10" set:html={translations.sthalamFeatures.dataPrivacy.description}>
        </p>
      </div>

      <!-- Built on Osvauld -->
      <div class="border border-white/10 rounded-2xl p-4 sm:p-8 hover:border-white/20 relative overflow-hidden transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#cba6f7]">
        <svg class="w-8 h-8 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.8448 7.34009C21.1348 6.86009 21.0748 6.23009 20.6598 5.81509L18.1848 3.34009C17.7698 2.92509 17.1398 2.87009 16.6598 3.15509C13.7398 1.61009 10.2598 1.61009 7.33984 3.15509C6.85984 2.86509 6.22984 2.92509 5.81484 3.34009L3.33984 5.81509C2.92484 6.23009 2.86984 6.86009 3.15484 7.34009C1.60984 10.2601 1.60984 13.7401 3.15484 16.6601C2.86484 17.1401 2.92484 17.7701 3.33984 18.1851L5.81484 20.6601C6.05984 20.9051 6.37984 21.0251 6.69984 21.0251C6.92484 21.0251 7.14484 20.9601 7.33984 20.8451C8.79984 21.6151 10.3998 22.0051 11.9998 22.0051C13.5998 22.0051 15.1998 21.6151 16.6598 20.8451C16.8548 20.9651 17.0798 21.0251 17.2998 21.0251C17.6198 21.0251 17.9398 20.9051 18.1848 20.6601L20.6598 18.1851C21.0748 17.7701 21.1298 17.1401 20.8448 16.6601C22.3898 13.7401 22.3898 10.2601 20.8448 7.34009Z" fill="#cba6f7"/>
        </svg>
        <h3 class="text-sm md:text-xl font-normal my-4 text-white relative z-10 font-JetBrainsMono">{translations.sthalamFeatures.builtOnOsvauld.title}</h3>
        <p class="text-customGray text-xs md:text-base font-JetBrainsMono leading-relaxed relative z-10" set:html={translations.sthalamFeatures.builtOnOsvauld.description}>
        </p>
      </div>

    </div>
  </section>
</div>
