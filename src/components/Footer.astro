---
import { Telegram } from "../assets/icons/Telegram";
import { GithubIcon } from "../assets/icons/GithubIcon";
import { FooterOsvauld } from "../assets/logos/FooterOsvauld.jsx";
import { getTranslations, getLocalizedPath } from "../i18n/utils";
import type { Locale } from "../i18n/ui";

interface Props {
  isLivnote?: boolean;
  isSthalam?: boolean;
  locale?: Locale;
}

const { isLivnote = false, isSthalam = false, locale = "en" } = Astro.props as Props;

const translations = await getTranslations(locale);

const heading = isSthalam
  ? translations.footer.heading.sthalam
  : isLivnote
  ? translations.footer.heading.livnote
  : translations.footer.heading.osvauld;
---

<section id="page-footer" class={`w-full ${isSthalam ? "bg-sthalamPrimary" : isLivnote ? "bg-livnotePrimary" : "bg-blue1"} z-50`}>
  <footer class="relative mx-auto h-[42rem]  md:h-[56rem] px-[24px] pt-[32px]  max-w-[1312px]  min-h-[545px] lg:px-[60px] lg:pt-[60px]">
    <div class="flex h-full flex-col gap-32">
      <div class="flex flex-col gap-24">
        <div class="icons flex items-center flex-wrap gap-10 mx-auto">
          <a href="https://github.com/osvauld/osvauld" target=”_blank” aria-label="View our project on GitHub"><GithubIcon color={"black"} size={"45px"} /></a>
          <a href="https://t.me/osvauld" target=”_blank” aria-label="Join our community on Telegram"><Telegram color={"black"} size={"45px"} /></a>
        </div>
        <span class="mx-auto text-4xl  sm:text-5xl md:text-6xl lg:text-7xl  tracking-[-2px] font-Jakartha font-semibold text-center">
          {heading}
        </span>

        <div class="text-center flex flex-col gap-4">
          <div class="flex items-center gap-4">
            <a href={getLocalizedPath("/terms", locale)} class="ml-auto tracking-tight" aria-label="Terms of Use">{translations.footer.terms}</a>
            <a href={getLocalizedPath("/privacy", locale)} class="mr-auto tracking-tight" aria-label="Privacy Policy">{translations.footer.privacy}</a>
          </div>
          <p class="font-medium text-sm md:text-base">{translations.footer.copyright}</p>
        </div>
      </div>
      <div class="absolute bottom-0 left-1/2 w-full -translate-x-1/2 px-[24px] lg:px-[60px]">
        <div class="flex w-full justify-center">
          <FooterOsvauld />
        </div>
      </div>
    </div>
  </footer>
</section>

