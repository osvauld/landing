>
  <div
    class="max-w-[1440px] w-full overflow-x-hidden overflow-y-hidden relative"
  >
      <h1
        class="text-blue1 font-semibold font-HostGrotesk text-left text-5xl md:text-6xl lg:text-7xl xl:text-8xl py-10 px-4 max-w-4xl"
