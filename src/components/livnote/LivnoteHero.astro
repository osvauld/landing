---
import type { TranslationKeys } from "../../i18n/ui";

export interface Props {
  translations: TranslationKeys;
}

import { GithubIcon } from "../../assets/icons/GithubIcon";
import { BottomArrow } from "../../assets/icons/BottomArrow";
import { Download } from "../../assets/icons/Download";
import { DownloadOptions } from "../../assets/icons/DownloadOptions";

const { translations } = Astro.props;
---

<section
  class="pt-10 lg:pt-16 px-2 pr-1 flex flex-col justify-start items-center bg-livnoteBg overflow-x-hidden "
  id="home"
>
  <div
    class="max-w-[1440px] w-full overflow-x-hidden overflow-y-hidden   pt-24 xll:px-12"
  >
    <div class="text-livnotePrimary  text-xs sm:text-sm font-bold flex justify-start text-left px-4">
      <a
        class="flex justify-center items-center font-normal text-sm xl:text-base rounded-md border border-livnotePrimary h-full px-4 py-2 cursor-pointer"
        href="https://github.com/osvauld/web-client"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="whitespace-nowrap">{translations.livnoteHero.openSource}</span>
        <span class="h-5 w-px bg-livnotePrimary mx-2"></span>
        <span class="flex text-white4 justify-center items-center whitespace-nowrap">
          <span class="mr-2 flex justify-center items-center">
            <GithubIcon color={"#A6B0BB"} size={18} />
          </span>
          {translations.livnoteHero.starOnGithub}
          <span class="transform -rotate-90 mt-1">
            <BottomArrow color={"#A6B0BB"} />
          </span>
        </span>
      </a>
    </div>
    <!-- Desktop layout: heading and download button side by side -->
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between px-4 py-10">
      <div class="flex-1">
        <h1 class="text-white1 font-medium font-Jakartha text-left text-5xl md:text-6xl lg:text-7xl xl:text-8xl">
          <span class="whitespace-normal lg:whitespace-nowrap text-livnotePrimary font-JetBrainsMono tracking-tighter" set:html={translations.livnoteHero.title}>
          </span>
        </h1>
        <div class="text-faqAnswer font-light text-base md:text-lg xl:text-xl pt-2 md:pt-12 tracking-wide max-w-[99vw] text-left font-JetBrainsMono" set:html={translations.livnoteHero.description}>
        </div>
      </div>
      
      <!-- Download button container - positioned to the right on desktop -->
      <div id="download-container" class="block lg:ml-8 mt-8 lg:mt-0 relative max-w-[260px] md:max-w-[300px] lg:max-w-[370px]">
        <div class="flex items-center justify-between border-livnotePrimary border-2 rounded-lg overflow-hidden">
          <button
            id="download-btn"
            class="px-8 py-4 flex items-center justify-center gap-6 text-xl transition-all duration-300 text-livnotePrimary"
            aria-label="Download for your platform"
            type="button"
            data-desktop-only-text={translations.livnoteHero.desktopOnly}
          >
            <Download size={44} />
            <div class="flex flex-col items-start">
              <span class="text-2xl">{translations.livnoteHero.download}</span>
              <span id="download-platform" class="text-base mt-2 font-light whitespace-nowrap"></span>
            </div>
          </button>
          <button
            id="dropdown-toggle"
            class="hidden lg:flex px-4 py-4  text-livnotePrimary items-center justify-center"
            aria-label="Show all download options"
            type="button"
          >
            <DownloadOptions color="#8A86E5" />
          </button>
        </div>

        <div
          id="download-dropdown"
          class="hidden absolute top-full right-0 mt-2 w-60 border z-50 bg-livnoteBg border-livnotePrimary rounded-lg text-livnotePrimary"
          role="menu"
        >
          <div class="p-2">
            <div class="text-sm px-3 py-2 border-b border-livnotePrimary my-1 ">
              {translations.livnoteHero.choosePlatform}
            </div>
            <button data-platform="mac" role="menuitem" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-dark2 transition-all duration-300">{translations.livnoteHero.platforms.mac}</button>
            <button data-platform="linux" role="menuitem" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-dark2 transition-all duration-300">{translations.livnoteHero.platforms.linux}</button>
            <button data-platform="fedora" role="menuitem" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-dark2 transition-all duration-300">{translations.livnoteHero.platforms.fedora}</button>
            <button data-platform="windows" role="menuitem" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-dark2 transition-all duration-300">{translations.livnoteHero.platforms.windows}</button>
          </div>
        </div>
        <div id="download-backdrop" class="hidden fixed inset-0 z-40"></div>
      </div>
    </div>
  </div>
  
</section>


<script defer>
  (function () {
    // 1. A flag to track if a download is in a "cooldown" state.
    let isDownloading = false;

    const platformToUrl = {
      mac: 'https://github.com/osvauld/osvauld/releases/download/alpha/livnote_0.1.0_aarch64.dmg',
      linux: 'https://github.com/osvauld/osvauld/releases/download/alpha/osvauld_0.1.0_amd64.deb',
      fedora: 'https://github.com/osvauld/osvauld/releases/download/alpha/osvauld-0.1.0-1.x86_64.rpm',
      windows: 'https://github.com/osvauld/osvauld/releases/download/alpha/osvauld_0.1.0_x64-setup.exe',
    };

    const platformToLabel = {
      mac: 'Mac (Apple Silicon)',
      linux: 'Linux (Debian)',
      fedora: 'Linux (Fedora)',
      windows: 'Windows',
    };

    function detectPlatform(){
      const ua = navigator.userAgent.toLowerCase();

      const isMobile = /android|iphone|ipad|mobile/.test(ua);
      if (isMobile) {
        return 'unsupported'; // Identifies mobile/tablet users
      }

      if (ua.includes('mac')) return 'mac';
      if (ua.includes('windows')) return 'windows';
      if (ua.includes('linux')) return 'linux';
      return 'unknown';
    }

    function startDownload(platform) {
      const url = platformToUrl[platform];
      if (!url) return;

      // Track download event using centralized analytics
      if (typeof window.trackDownload === 'function') {
        window.trackDownload(platform, 'livnote');
      }

      const a = document.createElement('a');
      a.href = url;
      a.download = url.split('/').pop() || '';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    function enhance() {
      const downloadContainer = document.getElementById('download-container');
      const btn = document.getElementById('download-btn');
      const dropdownToggle = document.getElementById('dropdown-toggle');
      const dropdown = document.getElementById('download-dropdown');
      const platformEl = document.getElementById('download-platform');
      const backdrop = document.getElementById('download-backdrop');
      
      const platform = detectPlatform();
      const isDesktop = platform !== 'unknown' && platform !== 'unsupported';
      
      if (!btn || !dropdownToggle || !dropdown || !platformEl || !backdrop) return;
      
      const downloadTextEl = btn.querySelector('.text-2xl');
      const originalBtnText = downloadTextEl.textContent;

      if (isDesktop) {
        platformEl.textContent = `for ${platformToLabel[platform]}`;
      } else {
        // Mobile/unsupported platform - show that download is available but not for this device
        const desktopOnlyText = btn.getAttribute('data-desktop-only-text') || 'Desktop only';
        platformEl.textContent = desktopOnlyText;
        btn.disabled = true;
        dropdownToggle.disabled = true;
        const container = btn.closest('.flex');
        if (container) {
          container.classList.add( 'cursor-not-allowed');
        }
        btn.classList.remove('hover:shadow-[4px_4px_0px_0px_#8A86E5]');
      }

      function openDropdown() {
        dropdown.classList.remove('hidden');
        backdrop.classList.remove('hidden');
      }
      function closeDropdown() {
        dropdown.classList.add('hidden');
        backdrop.classList.add('hidden');
      }

      // 2. Create a handler that enforces the cooldown.
      function handleDownload(selectedPlatform) {
        if (isDownloading) {
          return; 
        }

        // A. Set the flag, disable the button, and provide user feedback.
        isDownloading = true;
        btn.disabled = true;
        startDownload(selectedPlatform);

        // B. After 5 seconds, reset the flag and the button's appearance.
        setTimeout(() => {
          isDownloading = false;
          if (isDesktop) {
            btn.disabled = false;
          }
        }, 5000); // 5-second cooldown period
      }

      // Main download button - downloads detected platform
      btn.addEventListener('click', () => {
        // Only allow downloads on desktop platforms
        if (isDesktop) {
          handleDownload(platform);
        }
      });

      // Dropdown toggle button - shows all options
      dropdownToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isDesktop) {
          if (dropdown.classList.contains('hidden')) {
            openDropdown();
          } else {
            closeDropdown();
          }
        }
      });

      backdrop.addEventListener('click', closeDropdown);
      
      dropdown.addEventListener('click', (e) => {
        const trigger = e.target.closest('button[data-platform]');
        if (!trigger) return;
        const selected = trigger.getAttribute('data-platform');
        if (selected && isDesktop) {
          handleDownload(selected);
        }
        closeDropdown();
      });
    }

    if ('requestIdleCallback' in window) {
      (window).requestIdleCallback(enhance);
    } else {
      setTimeout(enhance, 0);
    }
  })();
</script>