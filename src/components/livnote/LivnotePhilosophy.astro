---
const desktopImagePath = "/assets/livnote-concept-art.png";
const mobileImagePath = "/assets/livnote-concept-art-mobile.webp";
import type { TranslationKeys } from "../../i18n/ui";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<section
  class="w-screen flex flex-col justify-start items-center mx-auto px-auto bg-livnoteBg px-4 pt-0 sm:pt-12 text-white"
>
  <div class="w-full mx-auto max-w-[1440px]">
    <div class="relative">
      <picture>
        <source media="(min-width: 800px)" srcset={desktopImagePath} />
        <source srcset={mobileImagePath} />
        <img
          src={mobileImagePath}
          alt="Concept art illustrating digital sovereignty and privacy-first collaboration with peer-to-peer technology"
          width="1400"
          height="800"
          class="mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="auto"
        />
      </picture>
    
      <!-- Shadows -->
      <div class="absolute top-0 left-0 h-full w-1/6 bg-gradient-to-r from-black to-transparent pointer-events-none"></div>
      <div class="absolute top-0 right-0 h-full w-1/6 bg-gradient-to-l from-black to-transparent pointer-events-none"></div>
      <div class="absolute top-0 left-0 w-full h-[10%] bg-gradient-to-b from-black to-transparent pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-full h-[10%] bg-gradient-to-t from-black to-transparent pointer-events-none"></div>
    </div>
    <h2
    class="max-w-[1400px] mx-auto text-white font-JetBrainsMono  text-left text-2xl font-normal mt-28 mb-10"
  >
    {translations.livnotePhilosophy.title}
  </h2>
  <p
    class="max-w-[1400px] mx-auto text-left text-base font-JetBrainsMono text-[#F1F7FE] opacity-70"
    set:html={translations.livnotePhilosophy.description}
  >
  </p>
  </div>


</section>
