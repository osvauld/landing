
---
import type { TranslationKeys } from "../../i18n/ui";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<section
  class="py-24 lg:pt-44 lg:pb-0 px-4 md:px-6 lg:px-8 flex flex-col justify-center items-center bg-livnoteBg"
  id="acknowledgement"
>
  <div class="max-w-[1400px] w-full text-left font-JetBrainsMono">
    <h2 class="text-white text-2xl font-normal mb-8">
      {translations.livnoteAcknowledgement.title}
    </h2>

    <p class="text-[#F1F7FE] opacity-70 text-base lg:text-lg text-left">
      {translations.livnoteAcknowledgement.description}
    </p>

  </div>
</section>

