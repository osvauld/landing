---
import { getImage } from "astro:assets";

import livnoteHeroSource from "../../assets/images/livnote.png";


const mobileImage = await getImage({
  src: livnoteHeroSource,
  width: 800,
  format: "webp",
  quality: 95,
});

const desktopImagePath = "/assets/livnote.webp";


---

<section
  class=" px-2 pr-1 flex flex-col justify-start items-center bg-livnoteBg overflow-x-hidden "
  id="hero-image"
>
  <div
    class="max-w-[1440px] w-full overflow-x-hidden overflow-y-hidden  pt-4 xll:px-12"
  >
    <div class="flex justify-center items-center mt-12 border-4 md:border-[10px] border-calBorder rounded-xl overflow-hidden relative aspect-[16/9]">
      <picture>
        <source
          media="(min-width: 769px)"
          srcset={desktopImagePath}
        />
      
        <source srcset={mobileImage.src} />
      
        <img
          id="hero-full-image"
          src={mobileImage.src}
          alt="Dashboard of the Livnote application"
          width="1200"
          height="800"
          class="z-10 absolute w-full h-full top-0 left-0 object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="auto"
        />
      </picture>
    </div>
  </div>
  
</section>
