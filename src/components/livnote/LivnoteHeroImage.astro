---

import livnoteHeroSource from "../../assets/images/livnote.webp";
---

<section
  class=" px-2 pr-1 flex flex-col justify-start items-center bg-livnoteBg overflow-x-hidden "
  id="hero-image"
>
  <div
    class="max-w-[1440px] w-full overflow-x-hidden overflow-y-hidden  pt-4 xll:px-12"
  >
    <div class="flex justify-center items-center lg:mt-12  overflow-hidden relative aspect-[16/9]">

        <img
          id="hero-full-image"
          src={livnoteHeroSource.src}
          alt="Dashboard of the Livnote application"
          width="1200"
          height="800"
          class="z-10 absolute w-full h-full top-0 left-0 object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="auto"
        />
    </div>
  </div>
  
</section>
