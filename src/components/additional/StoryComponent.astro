---
import type { TranslationKeys } from "../../i18n/ui";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<section class="w-full min-h-screen mx-auto bg-dark1 px-4 py-20">
  <div class="max-w-4xl mx-auto text-white">
    <h1 class="text-4xl md:text-6xl font-bold mb-8 text-blue1 text-center">
      {translations.story.title}
    </h1>
    
    <div class="prose prose-lg max-w-none text-white">
      <div class="space-y-8 text-lg leading-relaxed">
        <p set:html={translations.story.introduction}>
        </p>
        
        <h2 class="text-2xl md:text-3xl font-semibold text-blue1 mt-12 mb-6">
          {translations.story.founding.title}
        </h2>
        <p set:html={translations.story.founding.description}>
        </p>
        
        <h2 class="text-2xl md:text-3xl font-semibold text-blue1 mt-12 mb-6">
          {translations.story.vision.title}
        </h2>
        <p set:html={translations.story.vision.description}>
        </p>
        
        <h2 class="text-2xl md:text-3xl font-semibold text-blue1 mt-12 mb-6">
          {translations.story.mission.title}
        </h2>
        <p set:html={translations.story.mission.description}>
        </p>
        
        <h2 class="text-2xl md:text-3xl font-semibold text-blue1 mt-12 mb-6">
          {translations.story.future.title}
        </h2>
        <p set:html={translations.story.future.description}>
        </p>
        
        <div class="bg-dark4 rounded-lg p-8 mt-12 border border-blue1/20">
          <h3 class="text-xl font-semibold text-blue1 mb-4">
            {translations.story.joinUs.title}
          </h3>
          <p set:html={translations.story.joinUs.description}>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>