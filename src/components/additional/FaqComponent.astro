---
import { Calender } from "../../assets/icons/Calender";
import { CloseIcon } from "../../assets/icons/CloseIcon";
import { Telegram } from "../../assets/icons/Telegram";
import questionLeft from "../../assets/images/questionLeft.webp";
import { Image } from "astro:assets";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  data: FaqItem[];
  parent?: string;
}

const { data = [], parent } = Astro.props as Props;
---

<section
  class={`w-full min-h-[70vh]  mx-auto  ${parent === "livnote" ? "bg-livnoteBg" : "bg-dark1"} px-4 relative`}
  id="faqs"
>
  <div class="w-full pt-18 lg:pt-28 md:pb-10  text-white max-w-[1400px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-[40%_60%] gap-6">
      <div class="flex flex-col justify-start items-center md:items-start ">
        <h1 class={`z-10 md:absolute md:top-24 text-[36px] mb-6 mt-[4rem] md:text-[68px] font-medium w-full md:w-[350px] md:h-[246px] leading-[41px] md:leading-[81px]  gradient-text text-center md:text-left md:ml-[1.5rem] ${parent === "livnote" ? "font-JetBrainsMono tracking-[-0.1em] " : "font-Jakartha"}`}>
          Frequently Asked Questions
        </h1>

        <Image
        src={questionLeft}
        alt="purely visual element"
        class="hidden md:block  md:mt-[10rem] "
        loading="lazy"
        decoding="async"
        fetchpriority="auto"
        format="webp"
      />
        
      </div>
      <div class="z-30 questions px-0 md:px-10 w-full md:w-auto mt-8 md:mt-10 select-none">
        {data.map((item) => (
          <details
            class={`mb-4 rounded-lg px-6 py-4 border group border-faqBorder transition-shadow duration-200 hover:shadow-[3px_3px_0px_0px_#8A86E5] ${parent === "livnote" ? "bg-livnoteBg" : "bg-dark4"}`}
          >
            <summary class={`cursor-pointer flex justify-between items-center text-xl list-none ${parent === "livnote" ? "font-JetBrainsMono" : "font-Jakartha"} font-light`}>
              <span>{item.question}</span>
              <span class="rotate-45 group-open:rotate-90 transition-transform duration-75 ease-in ml-5">
                <CloseIcon />
              </span>
            </summary>
            <div class={`mt-6 text-base text-faqAnswer ${parent === "livnote" ? "font-JetBrainsMono" : "font-Jakartha"} font-light`}>
              <p>
                {item.answer.split("\n").map((line) => (
                  <span>
                    {line}
                    <br />
                  </span>
                ))}
              </p>
            </div>
          </details>
        ))}
      </div>
<!-- 
      <div class={` md:hidden px-6 py-4 h-[170px]  flex flex-col justify-between rounded-2xl  my-16 md:mt-8 text-center md:text-left border border-faqBorder ${parent === "livnote" ? "bg-livnoteBg font-JetBrainsMono" : "bg-dark4 font-Jakartha"}`}>
        <span class="font-light text-xl font-JetBrainsMono">
          Still have a question? <br />
        </span>
        <span class={`text-base font-extralight  ${parent === "livnote" ? "font-JetBrainsMono text-[#F1F7FE] opacity-70 " : "font-Jakartha"}`}>
          Contact us. We will be happy to help you! <br />
        </span>
        <div class="flex justify-center gap-3 items-center text-sm font-normal mt-4 md:mt-0">
          <button class={`rounded-md px-5 py-2 gap-1 flex items-center flex-nowrap whitespace-nowrap  ${parent === "livnote" ? "bg-livnotePrimary text-black" : "bg-blue1 text-dark2"}`}>
            <Calender color={"#0D1117"} />
            <a href="https://cal.com/abrahamgeorge/30min">Get a Demo</a>
          </button>
          <button class={`rounded-md px-5 py-2 gap-1 flex items-center flex-nowrap whitespace-nowrap ${parent === "livnote" ? "bg-livnotePrimary text-black" : "bg-blue1 text-dark2"}`}>
            <Telegram color={"#0D1117"} size={"20px"} />
            <a href="https://t.me/osvauld">Chat with us</a>
          </button>
        </div>
      </div> -->
    </div>
  </div>
</section>

