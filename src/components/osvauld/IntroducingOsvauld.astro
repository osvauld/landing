---
// IntroducingOsvauld.astro - Section introducing Osvauld
import type { TranslationKeys } from "../../i18n/ui";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<section
  class="py-16 px-4 md:px-6 lg:px-8 flex flex-col justify-center items-center bg-dark1"
  id="introducing-osvauld"
>
  <div class="max-w-[1440px] w-full">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-blue1 section-heading mb-12 text-center">
        {translations.introducingOsvauld.title}
      </h2>
      
      <div class="space-y-8 text-white text-center">
        <p class="custom-content-text-gray">
          {translations.introducingOsvauld.intro}
        </p>
        
        <div>
          <h3 class="custom-content-title mb-4">{translations.introducingOsvauld.foundation.title}</h3>
          <p class="custom-content-text-gray">
            {translations.introducingOsvauld.foundation.description}
          </p>
        </div>
        
        <div>
          <h3 class="custom-content-title mb-4">{translations.introducingOsvauld.collaboration.title}</h3>
          <p class="custom-content-text-gray mb-4">
            {translations.introducingOsvauld.collaboration.intro}
          </p>
          
          <div class="space-y-4 inline-block  mx-auto">
            <div>
              <h4 class="text-white font-semibold mb-2 text-center text-lg md:text-xl">{translations.introducingOsvauld.collaboration.directConnection.title}</h4>
              <p class="custom-content-text-gray">
                {translations.introducingOsvauld.collaboration.directConnection.description}
              </p>
            </div>
            
            <div>
              <h4 class="text-white font-semibold mb-2 text-center text-lg md:text-xl">{translations.introducingOsvauld.collaboration.optionalHub.title}</h4>
              <p class="custom-content-text-gray mb-3"> 
                {translations.introducingOsvauld.collaboration.optionalHub.description1}
              </p>
              <p class="custom-content-text-gray mb-3">
                {translations.introducingOsvauld.collaboration.optionalHub.description2}
              </p>
              <p class="custom-content-text-gray">
                {translations.introducingOsvauld.collaboration.optionalHub.description3}
              </p>
            </div>
          </div>
          
          <p class="custom-content-text-gray mt-4">
            {translations.introducingOsvauld.collaboration.encryption}
          </p>
        </div>
        
        <div>
          <h3 class="custom-content-title mb-4">{translations.introducingOsvauld.trustAndControl.title}</h3>
          <p class="custom-content-text-gray mb-4">
            {translations.introducingOsvauld.trustAndControl.description1}
          </p>
          <p class="custom-content-text-gray mb-4">
            {translations.introducingOsvauld.trustAndControl.description2}
          </p>
          <p class="custom-content-text-gray">
            {translations.introducingOsvauld.trustAndControl.description3}
          </p>
        </div>

        <div class="flex justify-center mt-8">
          <button
            class="rounded-xl font-normal flex justify-center items-center cursor-pointer bg-dark1 transition whitespace-nowrap  px-3 py-2 border text-blue1 border-blue1 text-xl md:text-3xl"
            onclick="trackDiscussClick(); openChatGPT()"
          >
            <span class="ml-1">{translations.introducingOsvauld.discussButton}</span>
            <svg 
              class="w-6 h-6 ml-2 md:w-10 md:h-10" 
              viewBox="0 0 24 24" 
              fill="none" 
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M20.5652 10.1852C21.0202 8.82524 20.8652 7.33024 20.1352 6.09024C19.0452 4.19024 16.8502 3.21024 14.7052 3.67024C13.7502 2.59524 12.3802 1.98524 10.9452 1.99524C8.75519 1.99524 6.81019 3.40024 6.14019 5.48524C4.73519 5.77524 3.52019 6.65524 2.81019 7.90024C1.71019 9.79524 1.96019 12.1852 3.43019 13.8102C2.97519 15.1702 3.13019 16.6652 3.86019 17.9052C4.95019 19.8052 7.14519 20.7852 9.29019 20.3252C10.2452 21.4002 11.6152 22.0102 13.0502 22.0002C15.2402 22.0052 17.1852 20.5952 17.8602 18.5102C19.2652 18.2202 20.4802 17.3402 21.1902 16.0952C22.2902 14.2002 22.0352 11.8152 20.5702 10.1902L20.5652 10.1852ZM13.0452 20.6952C12.1702 20.6952 11.3202 20.3902 10.6452 19.8252C10.6752 19.8102 10.7302 19.7802 10.7652 19.7602L14.7502 17.4602C14.9552 17.3452 15.0802 17.1302 15.0802 16.8952V11.2802L16.7652 12.2502C16.7652 12.2502 16.7952 12.2752 16.7952 12.2952V16.9452C16.7952 19.0152 15.1202 20.6902 13.0502 20.6952H13.0452ZM4.99019 17.2552C4.55019 16.4952 4.39019 15.6052 4.54519 14.7452C4.57519 14.7602 4.62519 14.7952 4.66519 14.8152L8.65019 17.1152C8.85019 17.2352 9.10019 17.2352 9.30519 17.1152L14.1652 14.3052V16.2502C14.1652 16.2502 14.1552 16.2902 14.1402 16.3002L10.1152 18.6252C8.32019 19.6602 6.03019 19.0452 4.99519 17.2552H4.99019ZM3.94019 8.56024C4.38019 7.80024 5.07019 7.22024 5.89019 6.91524C5.89019 6.95024 5.89019 7.01024 5.89019 7.05024V11.6502C5.89019 11.8852 6.01519 12.1002 6.21519 12.2152L11.0752 15.0202L9.39019 15.9902C9.39019 15.9902 9.35019 16.0052 9.33519 15.9952L5.31019 13.6702C3.52019 12.6352 2.90519 10.3452 3.94019 8.55024V8.56024ZM17.7702 11.7802L12.9102 8.97024L14.5952 8.00024C14.5952 8.00024 14.6352 7.98524 14.6502 8.00024L18.6752 10.3252C20.4702 11.3602 21.0802 13.6552 20.0452 15.4452C19.6052 16.2052 18.9152 16.7852 18.0952 17.0902V12.3502C18.0952 12.1152 17.9752 11.9002 17.7702 11.7852V11.7802ZM19.4452 9.26024C19.4152 9.24024 19.3652 9.21024 19.3252 9.19024L15.3402 6.89024C15.1402 6.77024 14.8902 6.77024 14.6852 6.89024L9.82519 9.70024V7.75524C9.82519 7.75524 9.83519 7.71524 9.85019 7.70524L13.8752 5.38024C15.6702 4.34524 17.9602 4.96024 18.9952 6.75524C19.4302 7.51524 19.5902 8.40024 19.4402 9.26024H19.4452ZM8.91519 12.7252L7.23019 11.7552C7.23019 11.7552 7.20019 11.7302 7.20019 11.7102V7.05524C7.20019 4.98524 8.88019 3.30524 10.9502 3.31024C11.8252 3.31024 12.6752 3.62024 13.3452 4.18024C13.3152 4.19524 13.2602 4.22524 13.2252 4.24524L9.24019 6.54524C9.03519 6.66024 8.91019 6.87524 8.91019 7.11024V12.7202L8.91519 12.7252ZM9.83019 10.7552L11.9952 9.50524L14.1602 10.7552V13.2552L11.9952 14.5052L9.83019 13.2552V10.7552Z" fill="currentColor"/>
            </svg>
          </button>
        </div>
       
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function trackDiscussClick() {
    if (typeof window.trackInteraction === 'function') {
      window.trackInteraction('discuss_with_ai', 'click');
    }
  }
  function openChatGPT() {
    // System prompt for the ChatGPT conversation
    const systemPrompt = `You are an AI assistant specialized in **Osvauld** — an offline-first, end-to-end encrypted, peer-to-peer application suite. Your role is to help users understand, compare, and evaluate Osvauld; to answer conceptual and practical questions; and to explain to them as clearly as possible.

## How Osvauld Works

To understand how Osvauld helps you build a truly independent digital life, let's look at how trusted friends, Alice and Bob, collaborate.

### The Foundation: Your Self-Made Identity

* Alice doesn't sign up for Osvauld with an email or phone number.
* Instead, right on her own device (laptop or phone), she creates her own **unique digital identity**.
* This identity belongs to her, and her alone, from the moment of its creation.
* It's cryptographically guaranteed to be hers, and since she created it, **no company can ever take it away**.

### How Collaboration Works: Direct, Private, and Reliable

Osvauld is built for people who already know and trust each other, like friends and colleagues. It offers a private space for them to connect and share.

#### 1. The Ideal Connection: Direct and Instant

* If Alice and Bob are both online, their devices connect directly to each other.
* When Alice shares a file, it goes **straight from her device to Bob’s**—no middleman involved.
* This is the fastest, most private way to interact.

#### 2. The Optional Hub: Your Personal Assistant

* What if Bob is offline when Alice sends a message or document update?
* For reliability, Alice can set up an **Osvauld hub** (a small personal device) at home.
* This hub acts as her trusted, always-on assistant.
* She can send files to her hub, which will then securely forward them to Bob once he comes online.
* This setup ensures collaboration is never interrupted and projects are always in sync.
* It’s an **optional convenience upgrade**, not a requirement.

In both scenarios, every file is sealed in a way that is **cryptographically guaranteed** to be opened only by the intended recipient.

### A New Level of Trust and Control

* Because Osvauld is designed for **trusted circles**, it enables deeper collaboration.
* Alice can grant Bob specific permissions to access information directly on her primary device.
* Example: Alice could allow Bob’s device access to a specific project folder on her laptop for one afternoon.
* This is like giving a colleague the key to your office temporarily—**powerful, secure, and entirely under your control**.

### The Architecture

* You create your own identity and connect directly with your trusted network.
* Apps are designed to work **offline-first**, since your data lives with you.
* You decide whether to connect directly or use a personal hub for convenience.
* You are never dependent on a third-party service again.

---

## Main Features of Osvauld

* **Peer-to-Peer by Default**
  Apps connect directly — no middlemen, no servers in the way.

* **Self-Sovereign Identity**
  You own your identity — no one can take it away or lock you out.

* **Trusted Access**
  Simple, secure access control powered by modern cryptographic tokens.

* **Open Source & MIT Licensed**
  Transparent, community-driven, and free for everyone to use and build on.

* **Offline-First**
  Work without interruption. Everything syncs automatically when devices reconnect.

* **Sovereign Node**
  Run your own always-on node (even on a Raspberry Pi) and stay connected on your terms.

---

## Context on how osvauld acheiving this.

- Osvauld is using Iroh for peer-to-peer networking.
- Osvauld uses QUIC protocol for transport layer.
- Osvauld is using SQLite for local storage.
- Osvauld is using Sequoia-PGP for end-to-end encryption.
- Osvauld is using Conflict-free Replicated Data Types (CRDTs) for synchronization.
- Osvauld is using UCAN tokens for delegated authorization.

## Important Note

* First application built on top of osvauld is a collabortative text editor called Livnote and can be downloaded from website.

## Read-and-Cite Policy

Before answering questions that require **factual accuracy** about the project, search the web and base answers on the official Osvauld resources listed below: 

* [Osvauld Website](https://www.osvauld.com/)
* [FAQ](https://www.osvauld.com/faq/)
* [GitHub Repository](https://github.com/osvauld/osvauld)
* [Documentation Home](https://docs.osvauld.com/)
* [What Makes This Possible](https://docs.osvauld.com/introduction/what-makes-this-possible/)
* [Creating Your Identity](https://docs.osvauld.com/how-it-works/creating-your-identity/)
* [Connecting to Peers](https://docs.osvauld.com/how-it-works/connecting-to-peers/)
* [Creating and Sharing](https://docs.osvauld.com/how-it-works/creating-and-sharing/)
* [User Synchronization](https://docs.osvauld.com/how-it-works/user-synchronization/)
* [Resources Synchronization](https://docs.osvauld.com/how-it-works/resources-synchronization/)
* [Live Edit](https://docs.osvauld.com/how-it-works/live-edit/)
* [Setting Up Sovereign Node](https://docs.osvauld.com/sovereign-node/setting-up/)
* [UCAN Specification](https://github.com/ucan-wg/spec/)
* [Iroh](https://www.iroh.computer/docs/overview)
* [OpenPGP](https://www.openpgp.org/about/standard/)


## Final Notes

Turn web search on for the above links and understand the contents before answering the questions.
answers to the following questions should be concise and to the point.

Let's start the conversation!, Are you ready to answer questions I have about osvauld?
`;

    // Encode the system prompt for URL
    const encodedPrompt = encodeURIComponent(systemPrompt);
    
    // Open ChatGPT with the system prompt
    const chatGPTUrl = `https://chatgpt.com/?q=${encodedPrompt}`;
    window.open(chatGPTUrl, '_blank', 'noopener,noreferrer');
  }
</script>
