---
// CollaborativeEditor.astro - Section about collaborative text editor
---

<style>
  @keyframes smoothGlow {
    0%, 100% { opacity: 0.15; transform: scaleX(0.8); }
    50% { opacity: 0.4; transform: scaleX(1.2); }
  }
  
  @keyframes smoothGlowSecondary {
    0%, 100% { opacity: 0.2; transform: scaleX(0.9); }
    50% { opacity: 0.35; transform: scaleX(1.1); }
  }
  
  @keyframes smoothGlowInner {
    0%, 100% { opacity: 0.25; transform: scaleX(1); }
    50% { opacity: 0.45; transform: scaleX(1.3); }
  }
  
  .smooth-glow-outer {
    animation: smoothGlow 4s ease-in-out infinite;
  }
  
  .smooth-glow-secondary {
    animation: smoothGlowSecondary 3s ease-in-out infinite 1s;
  }
  
  .smooth-glow-inner {
    animation: smoothGlowInner 2.5s ease-in-out infinite 0.5s;
  }
</style>

<section
  class="py-16 pb-0 lg:pb-16 px-4 md:px-6 lg:px-8 flex flex-col justify-center items-center bg-dark1 relative overflow-hidden"
  id="collaborative-editor"
>
  <!-- Component level animated vertical light gradient from right viewport - Mobile only -->
  <div class="absolute -right-8 top-0 w-16 h-full md:hidden">
    <div 
      class="w-full h-full smooth-glow-outer"
      style="background: linear-gradient(to left, #8A86E5 0%, #8A86E5 20%, transparent 70%); filter: blur(40px);"
    ></div>
  </div>
  
  <!-- Secondary vertical glow layer - Mobile only -->
  <div class="absolute -right-5 top-0 w-10 h-full md:hidden">
    <div 
      class="w-full h-full smooth-glow-secondary"
      style="background: linear-gradient(to left, #8A86E5 0%, #8A86E5 30%, transparent 80%); filter: blur(30px);"
    ></div>
  </div>
  
  <!-- Inner vertical glow layer - Mobile only -->
  <div class="absolute -right-2.5 top-0 w-6 h-full md:hidden">
    <div 
      class="w-full h-full smooth-glow-inner"
      style="background: linear-gradient(to left, #8A86E5 0%, #8A86E5 40%, transparent 90%); filter: blur(25px); box-shadow: -20px 0 60px #8A86E5;"
    ></div>
  </div>

  <div class="max-w-[1440px] w-full text-center relative z-10">
    <h2 class="text-blue1 font-semibold font-HostGrotesk text-3xl md:text-4xl lg:text-5xl mb-8">
      Explore our<br />
      collaborative<br />
      text editor
    </h2>
    
    <p class="text-customGray text-base md:text-lg mb-12 max-w-2xl mx-auto font-HostGrotesk">
      First of many tools for a personal internet.
    </p>
    
    <div class="mb-12">
      <a href="/livnote" class="text-livnotePrimary font-semibold font-HostGrotesk flex items-center justify-center gap-2 group">
        Explore Livnote
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>
