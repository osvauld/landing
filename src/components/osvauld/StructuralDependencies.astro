---
// StructuralDependencies.astro - Section about structural dependencies of today's internet
import type { TranslationKeys } from "../../i18n/ui";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<section
  class="pt-16 pb-8  md:pb-16 px-4 md:px-6 lg:px-8 flex flex-col justify-center items-center bg-dark1"
  id="structural-dependencies"
>
  <div class="max-w-[1440px] w-full">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-blue1 section-heading mb-12 md:mb-16">
        {translations.structuralDependencies.title}
      </h2>
      
      <div class="space-y-8 text-white">

          <p class="custom-content-text-gray">
            {translations.structuralDependencies.description}
          </p>
        

      </div>
    </div>
  </div>
</section>
