---
// CommunitySection.astro - Section about documentation and community
import type { TranslationKeys } from "../../i18n/ui";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<section
  class="py-24 lg:py-44 px-4 md:px-6 lg:px-8 flex flex-col justify-center items-center bg-dark1"
  id="community"
>
  <div class="max-w-[1440px] w-full text-center">
    <h2 class="text-blue1 section-heading mb-8" set:html={translations.communitySection.title}>
    </h2>

  </div>
</section>
