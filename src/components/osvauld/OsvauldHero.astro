---
// OsvauldHero.astro - Simplified hero component
import type { TranslationKeys } from "../../i18n/ui";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<section
  class="pt-16 px-1 md:pt-16 md:px-6 lg:pt-20 lg:px-8 flex flex-col justify-start items-center bg-dark1 overflow-x-hidden min-h-[80vh] lg:min-h-[85vh]"
  id="home"
>
  <div
    class="max-w-[1440px] flex justify-center items-center  w-full overflow-x-hidden overflow-y-hidden relative"
  >
      <h1
        class="text-blue1 font-semibold font-HostGrotesk text-center mb-0 text-4xl  sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl pt-8 pb-0 md:py-12 lg:py-16 px-4 md:px-6 lg:px-8 max-w-4xl"
        set:html={translations.osvauldHero.title}
      >
      </h1>
    </div>
    
      <div class="relative inline-block mt-8 md:mt-12 lg:mt-16 px-0 md:px-6 lg:px-8">
        <picture>
          <!-- Mobile and Tablet -->
          <source media="(max-width: 1024px)" srcset="/hero-osvauld-mobile.webp">
          <!-- Desktop -->
          <source media="(min-width: 1025px)" srcset="/hero-osvauld-desktop.webp">
          <!-- Fallback -->
          <img
            src="/hero-osvauld-mobile.webp"
            alt="Osvauld peer-to-peer application dashboard showing encrypted connections and offline-first architecture"
            class="w-auto h-auto object-contain opacity-80 flex justify-center items-center"
            loading="eager"
          />
        </picture>
        <div class="absolute top-0 left-0 w-1/6 sm:w-1/5 md:w-1/6 lg:w-1/8 h-full bg-gradient-to-r from-dark1 to-transparent pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-1/6 sm:w-1/5 md:w-1/6 lg:w-1/8 h-full bg-gradient-to-l from-dark1 to-transparent pointer-events-none"></div>
        <div class="absolute top-0 left-0 w-full h-2 sm:h-5 md:h-6 bg-gradient-to-b from-dark1 to-transparent pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-full h-2 sm:h-5 md:h-6 bg-gradient-to-t from-dark1 to-transparent pointer-events-none"></div>
      </div>
</section>
