
---
import type { TranslationKeys } from "../../i18n/ui";

interface Props {
  translations: TranslationKeys;
}

const { translations } = Astro.props;
---

<section
  class="pb-24 lg:pb-44 px-4 md:px-6 lg:px-8 flex flex-col justify-center items-center bg-dark1"
  id="community"
>
  <div class="max-w-[1440px] w-full text-center">
    <h2 class="text-blue1 section-heading mb-8">
      {translations.acknowledgement.title}
    </h2>

    <span class="mx-auto text-gray-400 text-sm md:text-base lg:text-lg text-center">
      {translations.acknowledgement.description}
    </span>

  </div>
</section>
