---
import { getAvailableLocales, getLocaleDisplayName, getLocaleNativeName, getLocaleEnglishName, getLocalizedPath } from "../i18n/utils";
import type { Locale } from "../i18n/ui";

interface Props {
  currentLocale: Locale;
  currentPath: string;
  isLivnote?: boolean;
}

const { currentLocale, currentPath, isLivnote = false } = Astro.props;

const availableLocales = getAvailableLocales();
---

<div class="relative inline-block">
  <button
    id="language-selector"
    class={`flex items-center gap-2 px-3 py-2 rounded-xl  border transition-colors ${
      isLivnote
        ? "text-livnotePrimary border-livnotePrimary hover:bg-livnoteBg/20"
        : "text-white1 border-gray-600 hover:bg-gray-800"
    }`}
    aria-label="Select language"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
    </svg>
    <span class="text-sm lg:text-base font-medium">{getLocaleEnglishName(currentLocale)}</span>
    <svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div
    id="language-dropdown"
    class={`hidden absolute top-full right-0 mt-2 w-48 border rounded-lg shadow-lg z-50 overflow-y-auto ${
      isLivnote
        ? "bg-livnoteBg border-livnotePrimary"
        : "bg-dark1 border-gray-600"
    }`}
    role="menu"
    aria-labelledby="language-selector"
  >
    <div class="py-1">
      {availableLocales.map((locale) => {
        const isCurrentLocale = locale === currentLocale;
        const localizedPath = getLocalizedPath(currentPath, locale);
        
        return (
          <a
            href={localizedPath}
            class={`block px-4 py-2 text-sm transition-colors ${
              isCurrentLocale
                ? isLivnote
                  ? "bg-livnotePrimary text-white font-medium"
                  : "bg-blue1 text-white font-medium"
                : isLivnote
                  ? "text-gray-300 hover:bg-livnoteBg/20 hover:text-white"
                  : "text-gray-300 hover:bg-gray-800 hover:text-white"
            }`}
            role="menuitem"
            aria-current={isCurrentLocale ? "page" : undefined}
            onclick={!isCurrentLocale ? `if (typeof window.trackLocaleChange === 'function') { window.trackLocaleChange('${currentLocale}', '${locale}'); }` : undefined}
          >
            <div class="flex items-center justify-between">
              <span>{getLocaleEnglishName(locale)}</span>
              <span class="text-xs text-white">{getLocaleNativeName(locale)}</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</div>

<script>
  function initLanguageSelector() {
    const button = document.getElementById('language-selector');
    const dropdown = document.getElementById('language-dropdown');
    
    if (!button || !dropdown) return;
    
    let isOpen = false;
    
    function toggleDropdown() {
      isOpen = !isOpen;
      dropdown.classList.toggle('hidden', !isOpen);
      button.setAttribute('aria-expanded', isOpen.toString());
      
      // Rotate arrow
      const arrow = button.querySelector('svg:last-child') as HTMLElement;
      if (arrow) {
        arrow.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
      }
      
      // Track language selector interaction
      if (typeof window.trackInteraction === 'function') {
        window.trackInteraction('language_selector', isOpen ? 'open' : 'close');
      }
    }
    
    function closeDropdown() {
      isOpen = false;
      dropdown.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
      
      // Reset arrow rotation
      const arrow = button.querySelector('svg:last-child') as HTMLElement;
      if (arrow) {
        arrow.style.transform = 'rotate(0deg)';
      }
    }
    
    button.addEventListener('click', (e) => {
      e.preventDefault();
      toggleDropdown();
    });
    
    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!button.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        closeDropdown();
      }
    });
    
    // Close dropdown on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDropdown();
      }
    });
  }
  
  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLanguageSelector);
  } else {
    initLanguageSelector();
  }
</script>

<style>
  #language-dropdown {
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
</style>
