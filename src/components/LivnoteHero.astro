---
import livnote from "../assets/images/livnote.webp";
import { Image } from "astro:assets";
import { GithubIcon } from "../assets/icons/GithubIcon";
import { BottomArrow } from "../assets/icons/BottomArrow";
import { Download } from "../assets/icons/Download";
import FontPerformanceMonitor from "./FontPerformanceMonitor.jsx";
---

<section
  class="pt-10 lg:pt-16 px-2 pr-1 flex flex-col justify-start items-center bg-livnoteBg overflow-x-hidden "
  id="home"
>
  <div
    class="max-w-[1440px] w-full overflow-x-hidden overflow-y-hidden  pt-24 xll:px-12"
  >
    <div class="text-livnotePrimary  text-xs sm:text-sm font-bold flex justify-start text-left px-4">
      <a
        class="flex justify-center items-center font-normal text-sm xl:text-base rounded-md border border-livnotePrimary h-full px-4 py-2 cursor-pointer"
        href="https://github.com/osvauld/web-client"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="whitespace-nowrap">We are open-source</span>
        <span class="h-5 w-px bg-livnotePrimary mx-2"></span>
        <span class="flex text-white4 justify-center items-center whitespace-nowrap">
          <span class="mr-2 flex justify-center items-center">
            <GithubIcon color={"#A6B0BB"} size={18} />
          </span>
          Star us on GitHub
          <span class="transform -rotate-90 mt-1">
            <BottomArrow color={"#A6B0BB"} />
          </span>
        </span>
      </a>
    </div>
    <h1 class=" text-white1 font-medium font-Jakartha text-left  text-5xl md:text-6xl lg:text-7xl xl:text-8xl  py-10 px-4">
      <span class=" whitespace-normal lg:whitespace-nowrap text-livnotePrimary font-JetBrainsMono tracking-tighter">
        Write together, <br /> stay private
      </span>
    </h1>
    <div class="text-faqAnswer font-light text-base md:text-lg xl:text-xl pt-12 tracking-wide max-w-[99vw] text-left font-JetBrainsMono px-4">
      Livnote lets you create and edit notes with others. <br class="hidden md:block" />  live, offline-first, and end to end encrypted.
      <br class="hidden md:block" />  - without anything ever touching a cloud server. 
    </div>
    <div class="flex items-center justify-start gap-4 md:flex-row text-sm flex-wrap pt-12 px-4 relative">
      <button
        id="download-btn"
        class="px-8 py-4 flex items-center justify-center gap-6 min-w-[200px]  border-livnotePrimary border-2 rounded-lg text-xl hover:bg-dark1 transition-all duration-300 text-livnotePrimary"
        aria-label="Download for your platform"
        type="button"
      >
        <Download size={44} />
        <div class="flex flex-col items-start">
          <span class="text-2xl">Download</span>
          <span id="download-platform" class="text-base mt-2 font-light whitespace-nowrap"></span>
        </div>
      </button>

      <div
        id="download-dropdown"
        class="hidden absolute top-full left-0 mt-2 w-64 border z-50 bg-dark1 border-livnotePrimary rounded-lg"
        role="menu"
      >
        <div class="p-2">
          <div class="text-sm px-3 py-2 border-b border-livnotePrimary my-1">
            Choose your platform:
          </div>
          <button data-platform="mac" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-dark2 transition-all duration-300">Mac (Apple Silicon)</button>
          <button data-platform="linux" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-dark2 transition-all duration-300">Linux (Debian)</button>
          <button data-platform="fedora" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-dark2 transition-all duration-300">Linux (Fedora)</button>
          <button data-platform="windows" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-dark2 transition-all duration-300">Windows</button>
        </div>
      </div>
      <div id="download-backdrop" class="hidden fixed inset-0 z-40"></div>
    </div>

    <div class="flex justify-center items-center mt-12 border-[10px] border-calBorder rounded-xl overflow-hidden relative">
      <!-- <img
        id="hero-placeholder-image"
        src={livnotethumb.src}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover blur-xl scale-105 transition-opacity duration-500"
        next opacity-0 transition-opacity duration-500
      /> -->
      <Image
        id="hero-full-image"
        src={livnote}
        alt="dashboard of livnote"
        width={1200}
        height={800}
        class="z-10 w-full h-auto object-cover "
        loading="eager"
        decoding="async"
        fetchpriority="high"
        densities={[1, 2]}
        format="webp"
        sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
      />
    </div>
  </div>
  
  <!-- Font Performance Monitor (Development Only) -->
  <FontPerformanceMonitor client:load />
</section>

<script defer>
  (function () {
    const platformToUrl = {
      mac: 'https://github.com/osvauld/osvauld/releases/download/alpha/osvauld_0.1.0_aarch64.dmg',
      linux: 'https://github.com/osvauld/osvauld/releases/download/alpha/osvauld_0.1.0_amd64.deb',
      fedora: 'https://github.com/osvauld/osvauld/releases/download/alpha/osvauld-0.1.0-1.x86_64.rpm',
      windows: 'https://github.com/osvauld/osvauld/releases/download/alpha/osvauld_0.1.0_x64-setup.exe',
    };

    const platformToLabel = {
      mac: 'Mac (Apple Silicon)',
      linux: 'Linux (Debian)',
      fedora: 'Linux (Fedora)',
      windows: 'Windows',
    };


    function detectPlatform(){
      const ua = navigator.userAgent.toLowerCase();
      if (ua.includes('mac')) return 'mac';
      if (ua.includes('windows')) return 'windows';
      if (ua.includes('linux')) return 'linux';
      return 'unknown';
    }

    function startDownload(platform) {
      const url = platformToUrl[platform];
      if (!url) return;
      const a = document.createElement('a');
      a.href = url;
      a.download = url.split('/').pop() || '';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    function enhance() {
      const btn = document.getElementById('download-btn');
      const dropdown = document.getElementById('download-dropdown');
      const platformEl = document.getElementById('download-platform');
      const backdrop = document.getElementById('download-backdrop');
      if (!btn || !dropdown || !platformEl || !backdrop) return;

      const platform = detectPlatform();
      if (platform !== 'unknown') {
        platformEl.textContent = `for ${platformToLabel[platform]}`;
      }

      function openDropdown() {
        dropdown.classList.remove('hidden');
        backdrop.classList.remove('hidden');
      }
      function closeDropdown() {
        dropdown.classList.add('hidden');
        backdrop.classList.add('hidden');
      }

      btn.addEventListener('click', () => {
        if (platform !== 'unknown' && platformToUrl[platform]) {
          startDownload(platform);
        } else {
          openDropdown();
        }
      });
      backdrop.addEventListener('click', closeDropdown);
      dropdown.addEventListener('click', (e) => {
        const target = e.target;
        if (!target) return;
        const trigger = target.closest('button[data-platform]');
        if (!trigger) return;
        const selected = trigger.getAttribute('data-platform');
        if (selected) startDownload(selected);
        closeDropdown();
      });
    }

    if ('requestIdleCallback' in window) {
      (window).requestIdleCallback(enhance);
    } else {
      setTimeout(enhance, 0);
    }
  })();
</script>


