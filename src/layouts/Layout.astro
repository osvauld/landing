---
import "@fontsource/inter";
import "@fontsource/inter/600.css";
import "@fontsource/plus-jakarta-sans";
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import '@fontsource/jetbrains-mono';
import { SEO } from "astro-seo";
import osvauldThumbnail from "../assets/images/osvauldthumb.webp";
import livnoteThumbnail from "../assets/images/livnotethumb.png";


import { Footer } from "../components/FooterV2.jsx";
import { Navbar } from "../components/Navbar.jsx";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Osvauld - Privacy-First P2P Application Framework",
  description = "Build peer-to-peer applications with Osvauld, a Rust framework for privacy-first, offline-capable apps. No servers, no data collection, complete user control. MIT licensed and open source.",
} = Astro.props;

const isLivnote = Astro.url.pathname.includes("/livnote");

// Choose the appropriate thumbnail based on the page
const pageThumbnail = isLivnote ? livnoteThumbnail : osvauldThumbnail;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png" />
    <link
      rel="apple-touch-icon"
      sizes="114x114"
      href="/apple-icon-114x114.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="120x120"
      href="/apple-icon-120x120.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="144x144"
      href="/apple-icon-144x144.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href="/apple-icon-152x152.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-icon-180x180.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/android-icon-192x192.png"
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title: isLivnote ? "Livnote - Peer-to-peer Collaborative Document Editor" : "Osvauld - Rust Framework for Privacy-First P2P Applications",
          type: "website",
          image: new URL(pageThumbnail.src, Astro.site).toString(),
        },
      }}
    />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://osvauld.com/#organization",
        "url": "https://osvauld.com",
        "name": "Osvauld",
        "legalName": "OSVAULD SECURITY SOLUTIONS PRIVATE LIMITED",
        "description": "Own Your Data, Leave No Footprint with Osvauld - a Rust framework for building peer-to-peer applications with privacy, security, and user control. Build collaborative tools, secure messaging, and privacy-first apps without servers or data collection.",
        "slogan": "Own Your Data, Leave No Footprint",
        "logo": "https://www.osvauld.com/assets/logo.png",
        "address": {
          "@type": "PostalAddress",
          "name": "OSVAULD SECURITY SOLUTIONS (OPC) PRIVATE LIMITED",
          "addressCountry": "India",
          "addressLocality": "Idukki",
          "addressRegion": "Kerala",
          "streetAddress": "Puthumanakudiyil House, Painavu PO, Thannikandam",
          "postalCode": "685602"
        },
        "email": "abe@osvauld.com",
        "foundingDate": "2024-04-26",
        "keywords": "peer-to-peer framework, Rust framework, privacy-first applications, offline-first, end-to-end encryption, CRDT, P2P networking, decentralized apps, open-source framework, MIT licensed, collaborative tools, secure messaging",
        "sameAs": [
          "https://github.com/osvauld",
          "https://in.linkedin.com/company/osvauld",
          "https://buymeacoffee.com/osvauld",
          "https://osvauld.com/#corporation"
        ],
        "owns": [
          {
            "@context": "http://schema.org",
            "@id": "https://osvauld.com/#framework",
            "@type": "SoftwareApplication",
            "name": "Osvauld Framework",
            "applicationCategory": "DeveloperApplication",
            "applicationSubCategory": "Software Development Framework",
            "operatingSystem": "Windows, macOS, Linux, Android, iOS",
            "description": "A Rust framework for building peer-to-peer applications with built-in privacy, security, and user control. Enables developers to create offline-first apps without servers or data collection.",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock"
            },
            "softwareRequirements": "Rust programming language",
            "storageRequirements": "Minimal local storage",
            "featureList": "P2P Networking, End-to-End Encryption, CRDT Integration, Offline-First Architecture, QUIC Protocol, Self-Sovereign Identity, Cross-Platform Support, MIT Licensed, Open Source",
            "license": "https://opensource.org/licenses/MIT",
            "about": {
              "description": "Osvauld Framework provides all the tools needed to build privacy-first, peer-to-peer applications in Rust, handling complex networking, encryption, and synchronization so developers can focus on their app's unique features."
            },
            "publisher": {
              "@context": "http://schema.org/",
              "@id": "https://osvauld.com/#corporation",
              "@type": "Corporation",
              "name": "Osvauld",
              "url": "https://osvauld.com",
              "logo": "https://www.osvauld.com/assets/logo.png"
            }
          },
          {
            "@context": "http://schema.org",
            "@id": "https://osvauld.com/#livnote",
            "@type": "SoftwareApplication",
            "name": "LivNote",
            "applicationCategory": "ProductivityApplication",
            "applicationSubCategory": "Collaborative Document Editor",
            "operatingSystem": "Windows, macOS, Linux, Android, iOS",
            "description": "A collaborative document editor built with Osvauld framework, featuring real-time peer-to-peer editing with end-to-end encryption and offline-first design.",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock"
            },
            "softwareRequirements": "Any modern operating system",
            "storageRequirements": "Minimal local storage",
            "featureList": "Real-Time Collaboration, End-to-End Encryption, Peer-to-Peer Connectivity, Offline-First Design, No Cloud Storage, Direct Device Synchronization, Open Source, MIT Licensed, Cross-Platform",
            "license": "https://opensource.org/licenses/MIT",
            "about": {
              "description": "LivNote demonstrates the power of Osvauld framework with real-time collaborative document editing that works entirely peer-to-peer without any servers or data collection."
            },
            "publisher": {
              "@context": "http://schema.org/",
              "@id": "https://osvauld.com/#corporation",
              "@type": "Corporation",
              "name": "Osvauld",
              "url": "https://osvauld.com",
              "logo": "https://www.osvauld.com/assets/logo.png"
            }
          },
          {
            "@context": "http://schema.org",
            "@id": "https://osvauld.com/#passwordmanager",
            "@type": "SoftwareApplication",
            "name": "Osvauld Password Manager",
            "applicationCategory": "UtilitiesApplication",
            "applicationSubCategory": "Credential Management Software",
            "operatingSystem": "Windows, macOS, Linux, Android, iOS",
            "description": "A secure password manager built with Osvauld framework, featuring peer-to-peer synchronization and team sharing capabilities without relying on cloud services.",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD",
              "availability": "https://schema.org/ComingSoon"
            },
            "softwareRequirements": "Any modern operating system",
            "storageRequirements": "Minimal local storage",
            "featureList": "End-to-End Encryption, Peer-to-Peer Sharing, Team Collaboration, Offline-First Design, No Cloud Storage, Direct Device Synchronization, Open Source, MIT Licensed, Cross-Platform",
            "license": "https://opensource.org/licenses/MIT",
            "about": {
              "description": "A password manager that showcases Osvauld framework's capabilities for secure credential management with team sharing, all without exposing data to third-party services."
            },
            "publisher": {
              "@context": "http://schema.org/",
              "@id": "https://osvauld.com/#corporation",
              "@type": "Corporation",
              "name": "Osvauld",
              "url": "https://osvauld.com",
              "logo": "https://www.osvauld.com/assets/logo.png"
            }
          }
        ],
        "potentialAction": {
          "@type": "DownloadAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://osvauld.com/download",
            "description": "Download Osvauld framework and applications"
          },
          "description": "Get started with Osvauld framework for building privacy-first P2P applications"
        }
      }
    </script>
  </head>

  <div>
    <Navbar client:load isLivnote={isLivnote}/>
    <slot />
    <Footer client:load isLivnote={isLivnote} />
    <style is:global>
      @font-face {
        font-family: "Inter";
        font-display: swap;
      }

      @font-face {
        font-family: "Plus Jakarta Sans";
        font-display: swap;
      }
      html {
        font-family: "Inter", "Plus Jakarta Sans";
        background-color: #010409;
        overflow-x: hidden;
        scroll-behavior: smooth;
        box-sizing: border-box;
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      html::-webkit-scrollbar {
        width: 4px;
        height: 130px;
      }

      html::-webkit-scrollbar-track {
        background: transparent;
      }

      html::-webkit-scrollbar-thumb {
        background-color: #2f303e;
        border-radius: 4px;
      }

      .active.html::-webkit-scrollbar-thumb {
        background-color: #2f303e; /* color of the thumb */
      }

      html::-webkit-scrollbar-thumb:hover {
        background-color: #2f303e; /* color of the thumb on hover */
      }
    </style>
  </div>
</html>