---
import "../styles/fonts.css";

interface Props {
  title: string;
  description?: string;
  locale?: string;
  bare?: boolean;
}

const {
  title,
  description = "Osvauld is building Xnet: private, sovereign shared software for people and their AI.",
  locale = "en",
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080a08" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Osvauld" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/host-grotesk-v5-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/host-grotesk-v5-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {!import.meta.env.DEV && <script data-goatcounter="https://osvauld.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>}
  </head>
  <body>
    {!bare && (
      <header class="legal-nav">
        <a href="/"><span>O</span> OSVAULD</a>
        <a href="/">Back to Xnet</a>
      </header>
    )}
    <slot />
    {!bare && (
      <footer class="legal-footer">
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <span>WITH ❤️ FROM 🇮🇳</span>
      </footer>
    )}
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { background: #080a08; }
  body { margin: 0; min-height: 100vh; font-family: "Host Grotesk", Arial, sans-serif; }
  .legal-nav, .legal-footer { width: min(100% - 3rem, 1100px); margin-inline: auto; display: flex; align-items: center; justify-content: space-between; font: .7rem "JetBrains Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
  .legal-nav { height: 5rem; color: #eef2e8; border-bottom: 1px solid rgba(238,242,232,.16); }
  .legal-nav a, .legal-footer a { color: inherit; text-decoration: none; }
  .legal-nav a:first-child { font-family: "Host Grotesk", sans-serif; font-weight: 600; }
  .legal-nav a:first-child span { display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; margin-right: .5rem; border: 1px solid currentColor; border-radius: 50%; }
  .legal-footer { gap: 2rem; padding: 2rem 0; color: #9da39a; }
  .legal-footer span { margin-left: auto; }
  @media (max-width: 520px) { .legal-nav, .legal-footer { width: calc(100% - 2rem); }.legal-footer { flex-wrap: wrap; }.legal-footer span { width: 100%; margin: 0; } }
</style>
