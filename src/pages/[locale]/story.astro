---
import Layout from "../../layouts/Layout.astro";
import "../../styles/Theme.css";
import StoryComponent from "../../components/additional/StoryComponent.astro";
import { getLocaleFromPath, getTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "de" } },
    { params: { locale: "ru" } },
    { params: { locale: "zh" } },
    { params: { locale: "fr" } },
    { params: { locale: "es" } },
    { params: { locale: "ja" } },
  ];
}

const locale = getLocaleFromPath(Astro.url.pathname);
const translations = await getTranslations(locale);
---

<Layout title={translations.meta.story.title} description={translations.meta.story.description} locale={locale}>
  <StoryComponent translations={translations} />
</Layout>
