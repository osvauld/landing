---
import Layout from "../../layouts/Layout.astro";
import "../../styles/Theme.css";
import FaqComponent from "../../components/additional/FaqComponent.astro";
import { data } from "../../components/additional/Data";
import { getLocaleFromPath, getTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "de" } },
    { params: { locale: "ru" } },
    { params: { locale: "zh" } },
    { params: { locale: "fr" } },
    { params: { locale: "es" } },
    { params: { locale: "ja" } },
  ];
}

const locale = getLocaleFromPath(Astro.url.pathname);
const translations = await getTranslations(locale);
---

<Layout title="FAQ" locale={locale}>
  <FaqComponent data={data} parent={"osvauld"} locale={locale} />
</Layout>
