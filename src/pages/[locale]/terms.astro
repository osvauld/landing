---
import Layout from "../../layouts/Layout.astro";
import "../../styles/Theme.css";
import { getLocaleFromPath, getTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "de" } },
    { params: { locale: "ru" } },
    { params: { locale: "zh" } },
    { params: { locale: "fr" } },
    { params: { locale: "es" } },
    { params: { locale: "ja" } },
    { params: { locale: "ml" } },
    { params: { locale: "hi" } },
    { params: { locale: "kn" } },
    { params: { locale: "ta" } },
    { params: { locale: "te" } },
    { params: { locale: "mr" } },
    { params: { locale: "ur" } },
    { params: { locale: "ar" } },
    { params: { locale: "ko" } },
  ];
}

const locale = getLocaleFromPath(Astro.url.pathname);
const translations = await getTranslations(locale);
---

<Layout title="Terms of Use" locale={locale}>
  <div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Terms of Use</h1>
    <div class="prose prose-lg">
      <p>Terms of use content will be translated and added here.</p>
    </div>
  </div>
</Layout>
