---
import Layout from "../../layouts/Layout.astro";
import LivnoteHero from "../../components/livnote/LivnoteHero.astro";
import LivnoteHeroImage from "../../components/livnote/LivnoteHeroImage.astro";
import FaqComponent from "../../components/additional/FaqComponent.astro";
import LivnoteFeatures from "../../components/livnote/LivnoteFeatures.astro";
import LivnotePhilosophy from "../../components/livnote/LivnotePhilosophy.astro";
import LivnoteAcknowledgement from "../../components/livnote/LivnoteAcknowledgement.astro";
import { getLocaleFromPath, getTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "de" } },
    { params: { locale: "ru" } },
    { params: { locale: "zh" } },
    { params: { locale: "fr" } },
    { params: { locale: "es" } },
    { params: { locale: "ja" } },
    { params: { locale: "ml" } },
    { params: { locale: "hi" } },
    { params: { locale: "kn" } },
    { params: { locale: "ta" } },
    { params: { locale: "te" } },
    { params: { locale: "mr" } },
    { params: { locale: "ur" } },
    { params: { locale: "ar" } },
    { params: { locale: "ko" } },
  ];
}

const locale = getLocaleFromPath(Astro.url.pathname);
const translations = await getTranslations(locale);
---

<Layout title={translations.meta.livnote.title} description={translations.meta.livnote.description} locale={locale}>
  <LivnoteHero translations={translations} />
  <LivnoteHeroImage />
  <LivnoteFeatures translations={translations} />
  <LivnotePhilosophy translations={translations} />
  <LivnoteAcknowledgement translations={translations} />
  <FaqComponent data={translations.faq.livnoteData} parent={"livnote"} translations={translations} />
</Layout>
