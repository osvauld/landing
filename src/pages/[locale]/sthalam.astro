---
import Layout from "../../layouts/Layout.astro";
import SthalamHero from "../../components/sthalam/SthalamHero.astro";
import SthalamHeroImage from "../../components/sthalam/SthalamHeroImage.astro";
import SthalamFeatures from "../../components/sthalam/SthalamFeatures.astro";
import SthalamPhilosophy from "../../components/sthalam/SthalamPhilosophy.astro";
import SthalamAcknowledgement from "../../components/sthalam/SthalamAcknowledgement.astro";
import { getLocaleFromPath, getTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "de" } },
    { params: { locale: "ru" } },
    { params: { locale: "zh" } },
    { params: { locale: "fr" } },
    { params: { locale: "es" } },
    { params: { locale: "ja" } },
    { params: { locale: "ml" } },
    { params: { locale: "hi" } },
    { params: { locale: "kn" } },
    { params: { locale: "ta" } },
    { params: { locale: "te" } },
    { params: { locale: "mr" } },
    { params: { locale: "ur" } },
    { params: { locale: "ar" } },
    { params: { locale: "ko" } },
  ];
}

const locale = getLocaleFromPath(Astro.url.pathname);
const translations = await getTranslations(locale);
---

<Layout title={translations.meta.sthalam.title} description={translations.meta.sthalam.description} locale={locale}>
  <SthalamHero translations={translations} />
  <SthalamHeroImage/>
  <SthalamFeatures translations={translations} />
  <SthalamPhilosophy translations={translations} />
  <SthalamAcknowledgement translations={translations} />
</Layout>
