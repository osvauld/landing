---
import "../styles/Theme.css";
import Layout from "../layouts/Layout.astro";
import OsvauldHero from "../components/osvauld/OsvauldHero.astro";
import StructuralDependencies from "../components/osvauld/StructuralDependencies.astro";
import IntroducingOsvauld from "../components/osvauld/IntroducingOsvauld.astro";
import Features from "../components/osvauld/Features.astro";
import CollaborativeEditor from "../components/osvauld/CollaborativeEditor.astro";
import CommunitySection from "../components/osvauld/CommunitySection.astro";
import Acknowledgement from "../components/osvauld/Acknowledgement.astro";
import { getTranslations } from "../i18n/utils";

const translations = await getTranslations("en");
---

<Layout title={translations.meta.osvauld.title} description={translations.meta.osvauld.description} locale="en">
  <OsvauldHero translations={translations} />
  <StructuralDependencies translations={translations} />
  <IntroducingOsvauld translations={translations} />
  <Features translations={translations} />
  <CollaborativeEditor translations={translations} />
  <CommunitySection translations={translations} />
  <Acknowledgement translations={translations} />
</Layout>
