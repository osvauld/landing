---
import Layout from "../layouts/Layout.astro";
import { LIVNOTEDATA } from "../components/additional/data";
import LivnoteHero from "../components/LivnoteHero.astro";

import ScrollUpButton from "../components/ScrollUpButton.astro";
import FaqComponent from "../components/additional/FaqComponent.astro";
import LivnoteFeatures from "../components/LivnoteFeatures.astro";
import LivnotePhilosophy from "../components/LivnotePhilosophy.astro";
---

<Layout title="Livnote" description="Livnote is a collaborative document editor built with Osvauld framework, featuring real-time peer-to-peer editing with end-to-end encryption and offline-first design." >
  <LivnoteHero />
  <LivnoteFeatures />
  <LivnotePhilosophy />
  <FaqComponent data={LIVNOTEDATA} parent={"livnote"} />
  <ScrollUpButton parent={"livnote"} />
</Layout>
