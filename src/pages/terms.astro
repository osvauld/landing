---
import Layout from "../layouts/Layout.astro";
import TermsOfUse from "../components/additional/TermsOfUse.astro";
---

<Layout title="Terms of Use — Osvauld" description="Terms governing use of the Osvauld website and software.">
  <main class="legal-page">
    <TermsOfUse />
  </main>
</Layout>

<style>
  .legal-page { width: min(100% - 3rem, 900px); margin: 3rem auto 6rem; padding: clamp(1.5rem, 5vw, 4rem); background: #fff; border-radius: 4px; }
  @media (max-width: 520px) { .legal-page { width: calc(100% - 1rem); margin-top: 1rem; } }
</style>
