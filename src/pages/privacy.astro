---
import Layout from "../layouts/Layout.astro";
import PrivacyPolicy from "../components/additional/PrivacyPolicy.astro";
---

<Layout title="Privacy Policy — Osvauld" description="How Osvauld handles information on its website and in its software.">
  <main class="legal-page">
    <PrivacyPolicy />
  </main>
</Layout>

<style>
  .legal-page { width: min(100% - 3rem, 900px); margin: 3rem auto 6rem; padding: clamp(1.5rem, 5vw, 4rem); background: #fff; border-radius: 4px; }
  @media (max-width: 520px) { .legal-page { width: calc(100% - 1rem); margin-top: 1rem; } }
</style>
